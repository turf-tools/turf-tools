# Optional overrides for the seeded admin user, used by `pnpm db:mock`.
# Defaults to admin@field.tools / "Admin User" when unset — set these to
# your own email/name if you want magic-link emails to reach you in dev.
# SEED_USER_EMAIL is the canonical form (lowercased; for gmail, dots
# stripped before any `+`); SEED_USER_DISPLAY_EMAIL is the typed form
# shown in the UI. Defaults DISPLAY to EMAIL when unset.
# SEED_USER_EMAIL=youname@gmail.com
# SEED_USER_DISPLAY_EMAIL=you.name@gmail.com
# SEED_USER_NAME="Your Name"
