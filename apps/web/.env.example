DATABASE_URL="postgresql://postgres:password@localhost:5432/field_tools"

# MapTiler API key for the basemap and label tiles. Sign up at maptiler.com.
VITE_MAPTILER_KEY=

# URL of the data service (apps/data). Used for static reads like
# /key-groups/{key_group}/geojson. Defaults to localhost:8000 if unset.
VITE_DATA_URL=http://localhost:8000