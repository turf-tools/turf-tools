# URL of the database.
DATABASE_URL="postgresql://postgres:password@localhost:5432/turf_tools"

# URL of the data service (apps/data). Internal and server-only. Web's
# /api proxies and oRPC handlers forward client requests here so the
# data service is never reachable from the browser.
DATA_URL=http://localhost:8000

# MapTiler API key for the basemap and label tiles. Sign up at maptiler.com.
VITE_MAPTILER_KEY=

# Better Auth signing secret. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Canonical origin for this deployment. Used to construct absolute URLs
# in outgoing emails (magic links) and to validate redirect targets.
# Dev: http://localhost:3000. Per-org production: https://<slug>.turf.tools.
BETTER_AUTH_URL=http://localhost:3000

# SMTP for sending magic-link emails — any provider (Resend's interface is
# smtp.resend.com, user `resend`, API key as password). Optional in dev —
# when unset, the magic link URL is logged to the server console instead.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=

# Sender used on magic-link emails. Must be a domain your SMTP provider
# has verified. Required for sending — when unset, links log to the
# console as above.
# EMAIL_FROM='Turf Tools <login@auth.turf.tools>'

# Optional: set to "1" to bypass auth entirely and impersonate the seeded
# admin. For local dev when you don't want to exercise the magic-link flow.
# AUTH_DISABLED=1

# Optional (per-deployment): set to "1" to require a click on the magic-link
# verify page instead of verifying on page load. Defeats email "detonation"
# scanners (e.g. Microsoft Safe Links) that execute the page's JS and would
# otherwise burn the single-use link before the user clicks. Costs one click;
# leave unset for deployments whose users aren't behind such gateways.
# AUTH_REQUIRE_LINK_CONFIRMATION=1
