# URL of the database.
DATABASE_URL="postgresql://postgres:password@localhost:5432/field_tools"

# MapTiler API key for the basemap and label tiles. Sign up at maptiler.com.
VITE_MAPTILER_KEY=

# URL of the data service (apps/data). Internal and server-only. Web's
# /api proxies and oRPC handlers forward client requests here so the
# data service is never reachable from the browser.
DATA_URL=http://localhost:8000