# Voter file fixture — `seed-persons` reads
# `{fixtures_dir}/{voter_file_fixture}`. Override `voter_file_fixture`
# to point at a smaller sample during development. If the fixture
# isn't present locally, the CLI prints `voter_file_url` so you can
# download it.
VOTER_FILE_URL=https://zohran-data-backups.nyc3.digitaloceanspaces.com/ny-voters-2026-03-08.parquet
VOTER_FILE_FIXTURE=ny-voters-2026-03-08-nyc.parquet
FIXTURES_DIR=fixtures

# TIGER download settings — defaults match `voter_file_fixture` (NYC).
# Override TIGER_COUNTY_FIPS as a JSON array if seeding from a non-NYC
# voter file (e.g. `["061"]` for Manhattan only).
# TIGER_YEAR=2024
# TIGER_STATE_FIPS=36
# TIGER_COUNTY_FIPS=["061","005","047","081","085"]
# TIGER_DATA_DIR=./tiger_cache

# DuckLake metadata catalog. Dev defaults to a Postgres catalog on the dev
# Postgres (concurrency-safe, so import jobs don't fight the serving connection
# over a single-writer local file) with local Parquet storage — no config
# needed. Both catalogs share the dev DB via distinct schemas (`ducklake`,
# `geo_ducklake`), auto-created on connect. Set these only to point elsewhere:
# DUCKLAKE_METADATA_POSTGRES_URL=
# GEO_DUCKLAKE_METADATA_POSTGRES_URL=
