{
  "expo": {
    "slug": "turf-tools",
    "owner": "turf-tools",
    "version": "1.0.1",
    "scheme": "turf-tools",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "icon": "./design/arrow-icon.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./design/arrow-icon-foreground.png",
        "monochromeImage": "./design/arrow-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shows your position on the map while you canvass. Your location stays on your device.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Camera use makes it possible to fill in turf information by scanning a QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5c5d36f-33e4-4f87-b44b-1c5c41be1337"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f5c5d36f-33e4-4f87-b44b-1c5c41be1337"
    }
  }
}
