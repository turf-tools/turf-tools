# MapTiler API key for the basemap and label tiles. Sign up at maptiler.com.
EXPO_PUBLIC_MAPTILER_KEY=

# Optional custom MapTiler style IDs. Defaults to streets-v4.
EXPO_PUBLIC_MAPTILER_STYLE_ID_LIGHT=
EXPO_PUBLIC_MAPTILER_STYLE_ID_DARK=

# The Turf Tools account's custom styles. They only resolve with a key from
# that account, so they stay commented out by default.
# EXPO_PUBLIC_MAPTILER_STYLE_ID_LIGHT=01968205-0dc7-71df-87a7-8b67f7828379
# EXPO_PUBLIC_MAPTILER_STYLE_ID_DARK=019d7ad6-3be3-7b78-86e3-853060587c76
