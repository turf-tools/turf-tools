# MapTiler API key for the basemap and label tiles. Sign up at maptiler.com.
EXPO_PUBLIC_MAPTILER_KEY=

# New checkouts use the public style. The Turf Tools custom styles are the
# code fallback when these are unset; they require a key from the account
# that owns them.
EXPO_PUBLIC_MAPTILER_STYLE_ID_LIGHT=streets-v4
EXPO_PUBLIC_MAPTILER_STYLE_ID_DARK=streets-v4

# The Turf Tools account's custom styles.
# EXPO_PUBLIC_MAPTILER_STYLE_ID_LIGHT=01968205-0dc7-71df-87a7-8b67f7828379
# EXPO_PUBLIC_MAPTILER_STYLE_ID_DARK=019d7ad6-3be3-7b78-86e3-853060587c76
