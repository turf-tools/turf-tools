@@ -35,15 +35,37 @@ - (void)removeReactSubview:(UIView *)subview {
   }
 }
 
+// React mount batches re-assert the yoga layout frame (origin at the
+// map's top-left), clobbering the position the map manages via `center`.
+// An off-viewport annotation is never repositioned by the map, so a
+// clobbered view rests visible at the layout origin — a ghost marker.
+// Once the annotation is on the map, accept only the SIZE from React;
+// position belongs to the map alone.
 - (void)reactSetFrame:(CGRect)frame {
   if ([_map.annotations containsObject:self]) {
-    [_map removeAnnotation:self];
+    CGRect bounds = self.bounds;
+    bounds.size = frame.size;
+    self.bounds = bounds;
+    [self _setCenterOffset:frame];
+    return;
   }
   [super reactSetFrame:frame];
   [self _setCenterOffset:frame];
   [self _addAnnotation];
 }
 
+// Same protection for direct frame assignment (the Fabric interop layer
+// applies layout metrics through setFrame:, not reactSetFrame:).
+- (void)setFrame:(CGRect)frame {
+  if ([_map.annotations containsObject:self]) {
+    CGRect bounds = self.bounds;
+    bounds.size = frame.size;
+    self.bounds = bounds;
+    return;
+  }
+  [super setFrame:frame];
+}
+
 - (void)setAnchor:(NSDictionary<NSString *, NSNumber *> *)anchor {
   _anchor = anchor;
   [self _setCenterOffset:self.frame];
@@ -110,7 +132,6 @@ - (MLNAnnotationView *)getAnnotationView {
     return nil;
   } else {
     // custom view
-    self.enabled = YES;
     const CGFloat defaultZPosition = 0.0;
     if (self.layer.zPosition == defaultZPosition) {
       self.layer.zPosition = [self _getZPosition];
@@ -125,6 +146,13 @@ - (CGFloat)_getZPosition {
   return latitudeMax - self.coordinate.latitude;
 }
 
+- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
+  if (!self.enabled) {
+    return nil;
+  }
+  return [super hitTest:point withEvent:event];
+}
+
 - (void)_handleTap:(UITapGestureRecognizer *)recognizer {
   [_map selectAnnotation:self animated:NO completionHandler:nil];
 }
@@ -178,6 +206,13 @@ - (void)_addAnnotation {
   }
 
   [_map addAnnotation:self];
+  // Park far offscreen until the map claims and positions the view — it
+  // must never rest visible at the React layout origin (see
+  // reactSetFrame:). The map overwrites `center` for any annotation
+  // whose coordinate is on-screen.
+  CGPoint parked = self.center;
+  parked.x = -100000;
+  self.center = parked;
   if (_reactSelected) {
     [_map selectAnnotation:self animated:NO completionHandler:nil];
   }
