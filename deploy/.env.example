# Settings for one deployment. Copy to /etc/turf-tools/.env on the machine
# (see deploy/README.md) and fill in. compose.yaml assembles the database
# connection strings from POSTGRES_PASSWORD, so they don't belong here.

# The public hostname. Caddy gets a TLS certificate for it, so it must point at
# this machine with ports 80 and 443 reachable from the internet.
DOMAIN=turf.example.org
BETTER_AUTH_URL=https://turf.example.org
NODE_ENV=production

# `latest` follows the newest release; pin a `sha-<commit>` tag to hold a
# version or roll back.
WEB_IMAGE=ghcr.io/turf-tools/turf-tools-web:latest
DATA_IMAGE=ghcr.io/turf-tools/turf-tools-data:latest

# openssl rand -hex 32  (hex, so it stays safe inside a postgres:// URL)
POSTGRES_PASSWORD=
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# S3-compatible object storage: one bucket per deployment, holding the voter
# data lakes, the search index, and backups under their own prefixes. The
# endpoint is a hostname, without https://. The provider must accept path-style
# requests, which the search index and backup sync use. STORAGE_URL_STYLE sets
# the data server's own addressing: `path`, or `vhost` for providers that
# require it.
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_URL_STYLE=path
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Outbound email for sign-in links. Any SMTP provider works. Leave all of these
# unset and the links are printed to the web service's log instead
# (`docker compose logs web`).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Turf Tools <noreply@turf.example.org>

# Optional: make sign-in links open a page with a button instead of signing in
# on the first visit. Set to 1 when your users' email security scanners open
# links before they do, which uses up the link.
# AUTH_REQUIRE_LINK_CONFIRMATION=1

# Optional: memory each of the data server's query engines may use before
# spilling to disk (default 10GB). The service as a whole uses a few GB more
# during an import, so size it to the machine leaving room for that and for
# Postgres: a statewide import runs fastest when it never spills.
# DUCKDB_MEMORY_LIMIT=10GB

# Development only. Never set AUTH_DISABLED on a deployment: it turns off
# sign-in entirely.
